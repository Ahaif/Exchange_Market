# Copy to .env.local. Browser variables are public; never put secrets in NEXT_PUBLIC_*.
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_TOKEN_ADDRESS=
NEXT_PUBLIC_EXCHANGE_ADDRESS=
NEXT_PUBLIC_DEPLOYMENT_BLOCK=0
# Optional public browser RPC for viewing market data without a wallet.
NEXT_PUBLIC_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Deployment only. Keep these out of Git and browser bundles.
RPC_URL=http://127.0.0.1:8545
DEPLOYER_PRIVATE_KEY=
FEE_ACCOUNT=
