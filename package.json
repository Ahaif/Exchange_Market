{
  "name": "hai-exchange",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "contracts:compile": "node scripts/compile.mjs",
    "test": "node --test test/v1/*.test.mjs",
    "contracts:deploy": "node --env-file=.env.local scripts/deploy.mjs",
    "chain": "ganache --chain.chainId 31337 --wallet.deterministic",
    "contracts:seed": "node --env-file=.env.local scripts/seed-exchange.mjs",
    "docs:update": "node scripts/update-progress.mjs",
    "docs:check": "node scripts/update-progress.mjs --check",
    "security:check": "node scripts/check-boundaries.mjs"
  },
  "dependencies": {
    "ethers": "^6.17.0",
    "lightweight-charts": "^5.3.0",
    "next": "16.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "^5.4.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "ganache": "7.9.2",
    "solc": "0.8.30",
    "typescript": "^5.9.0"
  }
}
